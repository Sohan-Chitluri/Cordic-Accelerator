#==============================================================================
# .gitignore for CORDIC Accelerator ASIC Project
#==============================================================================

# Verilator build artifacts
obj_dir/
*.vcd
*.fst
*.vpd

# Coverage
coverage.dat
*.annotated
coverage/

# Yosys synthesis
*.ys
output/
*.rpt
*.log

# OpenSTA
*.sta
sta_*.rpt

# Netgen (VLSI LVS) run-time config artifact
ng.ini

# SymbiYosys formal — ignore generated work directories, not source files
# (*.sby source files and tb/formal/cordic_formal.sby, tb/formal/cordic_formal_tb.sv are tracked)
*_bmc/
*_prove/
*_cover/
tb/formal/cordic_formal/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
venv/
env/

# Test vectors — generated by `make gen-vectors`, not part of the RTL baseline.
# Source: tb/golden_model.py (committed). Regenerate with: make gen-vectors
tb/test_vectors/*.json
tb/test_vectors/*.mem

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Build
build/
dist/
*.egg-info

# Local toolchain / PDK — fetched via `nix develop` setup, not part of the repo
# (see docs/PLACE_ROUTE_DRC.md for how to regenerate)
tools/OpenSTA/
pdk/
.venv/

# Logs
*.log

# Temporary files
*.tmp
*.temp